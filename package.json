{
  "name": "workout-tracker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "backend": "cd backend && mvnw.cmd spring-boot:run -Dspring-boot.run.profiles=local",
    "backend:test": "cd backend && mvnw.cmd test -Dspring.profiles.active=local",
    "backend:format": "cd backend && mvnw.cmd spotless:apply",
    "backend:format:check": "cd backend && mvnw.cmd spotless:check",
    "frontend": "cd frontend && npm run start",
    "frontend:test": "cd frontend && npm run test",
    "frontend:lint": "cd frontend && npm run lint",
    "frontend:lint:fix": "cd frontend && npm run lint:fix",
    "frontend:format": "cd frontend && npm run format",
    "app:format": "npm run frontend:format && npm run frontend:lint:fix && npm run backend:format",
    "app": "concurrently -n backend,frontend -k \"npm run backend\" \"npm run frontend\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexander-braun/workout-tracker.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/alexander-braun/workout-tracker/issues"
  },
  "homepage": "https://github.com/alexander-braun/workout-tracker#readme",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}